{
  "name": "jobtrack",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @jobtrack/web",
    "build": "npm run build -w @jobtrack/web",
    "start": "npm run start -w @jobtrack/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed -w @jobtrack/core",
    "import": "tsx migration/import.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "csv-parse": "^7.0.2",
    "tsx": "^4.23.12"
  }
}
