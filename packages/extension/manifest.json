{
  "manifest_version": 3,
  "name": "JobTrack Capture",
  "version": "0.1.0",
  "description": "One-click capture of job postings into your self-hosted JobTrack board.",
  "action": {
    "default_title": "Capture job posting"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "contextMenus"],
  "host_permissions": [
    "https://*/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ]
}
